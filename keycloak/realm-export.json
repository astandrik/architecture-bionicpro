{
  "realm": "reports-realm",
  "enabled": true,
  "displayName": "BionicPRO Reports",
  "accessTokenLifespan": 120,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "administrator",
        "description": "Administrator role"
      },
      {
        "name": "prothetic_user",
        "description": "Prothetic user role with report access"
      }
    ]
  },
  "groups": [
    {
      "name": "user",
      "realmRoles": ["user"]
    },
    {
      "name": "prothetic_user",
      "realmRoles": ["prothetic_user"]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 20
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 30
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 40
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "user2",
      "enabled": true,
      "email": "user2@example.com",
      "firstName": "User",
      "lastName": "Two",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["administrator"]
    },
    {
      "username": "prothetic1",
      "enabled": true,
      "email": "prothetic1@example.com",
      "firstName": "Prothetic",
      "lastName": "One",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    },
    {
      "username": "prothetic2",
      "enabled": true,
      "email": "prothetic2@example.com",
      "firstName": "Prothetic",
      "lastName": "Two",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    },
    {
      "username": "prothetic3",
      "enabled": true,
      "email": "prothetic3@example.com",
      "firstName": "Prothetic",
      "lastName": "Three",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [
        {
          "type": "password",
          "value": "prothetic123",
          "temporary": false
        }
      ],
      "realmRoles": ["prothetic_user"]
    }
  ],
  "clients": [
    {
      "clientId": "reports-frontend",
      "name": "Reports Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "bionicpro-auth",
      "name": "BionicPRO Auth Backend",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-auth-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8000/auth/callback"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "post.logout.redirect.uris": "http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "user.attribute": "foo"
          }
        }
      ]
    },
    {
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-reports-api-client-secret",
      "bearerOnly": true
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Яндекс ID",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": true,
      "addReadTokenRoleOnCreate": true,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "bionicpro-yandex-broker",
        "clientSecret": "change-me-yandex-oidc-client-secret",
        "authorizationUrl": "http://localhost:8000/yandex/authorize",
        "tokenUrl": "http://bionicpro-auth:8000/yandex/token",
        "userInfoUrl": "http://bionicpro-auth:8000/yandex/userinfo",
        "issuer": "http://localhost:8000/yandex",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT",
        "storeToken": "true",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "jwksUrl": "http://bionicpro-auth:8000/yandex/jwks",
        "clientAuthMethod": "client_secret_post",
        "disableUserInfo": "false",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "hideOnLoginPage": "false"
      }
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "openldap",
        "providerId": "ldap",
        "config": {
          "enabled": ["true"],
          "priority": ["0"],
          "fullSyncPeriod": ["-1"],
          "changedSyncPeriod": ["-1"],
          "cachePolicy": ["DEFAULT"],
          "editMode": ["READ_ONLY"],
          "importEnabled": ["true"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "connectionUrl": ["ldap://openldap:389"],
          "usersDn": ["ou=People,dc=example,dc=com"],
          "bindDn": ["cn=admin,dc=example,dc=com"],
          "bindCredential": ["change-me-ldap-bind-password"],
          "authType": ["simple"],
          "searchScope": ["1"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson"],
          "pagination": ["true"],
          "allowKerberosAuthentication": ["false"],
          "useKerberosForPasswordAuthentication": ["false"],
          "batchSizeForSync": ["1000"],
          "connectionPooling": ["true"]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "ldap-username",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["uid"],
                "user.model.attribute": ["username"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"],
                "is.mandatory.in.ldap": ["true"]
              }
            },
            {
              "name": "ldap-email",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["mail"],
                "user.model.attribute": ["email"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            },
            {
              "name": "ldap-first-name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["cn"],
                "user.model.attribute": ["firstName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            },
            {
              "name": "ldap-last-name",
              "providerId": "user-attribute-ldap-mapper",
              "config": {
                "ldap.attribute": ["sn"],
                "user.model.attribute": ["lastName"],
                "read.only": ["true"],
                "always.read.value.from.ldap": ["true"]
              }
            },
            {
              "name": "ldap-groups",
              "providerId": "group-ldap-mapper",
              "config": {
                "groups.dn": ["ou=Groups,dc=example,dc=com"],
                "group.name.ldap.attribute": ["cn"],
                "group.object.classes": ["groupOfNames"],
                "preserve.group.inheritance": ["true"],
                "ignore.missing.groups": ["true"],
                "membership.ldap.attribute": ["member"],
                "membership.attribute.type": ["DN"],
                "membership.user.ldap.attribute": ["uid"],
                "mode": ["LDAP_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"]
              }
            }
          ]
        }
      }
    ]
  }
}
