proxy_cache_path /var/cache/nginx/reports
  levels=1:2
  keys_zone=reports_cache:10m
  max_size=100m
  inactive=1h
  use_temp_path=off;

server {
  listen 80;
  server_name _;

  location = /health {
    default_type text/plain;
    return 200 "ok\n";
  }

  location /reports/ {
    if ($request_method = OPTIONS) {
      add_header Access-Control-Allow-Origin "*" always;
      add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
      add_header Access-Control-Allow-Headers "*" always;
      add_header Access-Control-Max-Age 3600 always;
      return 204;
    }

    secure_link $arg_signature,$arg_expires;
    secure_link_md5 "$secure_link_expires$uri ${REPORTS_CDN_SIGNING_SECRET}";

    if ($secure_link = "") {
      return 403;
    }

    if ($secure_link = "0") {
      return 410;
    }

    rewrite ^/reports/(.*)$ /bionicpro-reports/reports/$1 break;

    proxy_cache reports_cache;
    proxy_cache_valid 200 1h;
    proxy_cache_valid 404 1m;
    proxy_cache_key "$scheme$request_method$host$uri";

    proxy_set_header Host minio:9000;
    proxy_pass http://minio:9000;

    add_header X-Cache-Status $upstream_cache_status always;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cache-Control "public, max-age=3600" always;
  }
}
