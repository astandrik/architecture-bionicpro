PORT=8000
AUTH_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3001

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=reports-realm
KEYCLOAK_CLIENT_ID=bionicpro-auth
KEYCLOAK_CLIENT_SECRET=change-me-auth-client-secret

AUTH_COOKIE_SECRET=change-me-cookie-secret
AUTH_TOKEN_ENCRYPTION_KEY=change-me-token-encryption-key
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=1800
AUTH_SESSION_ROTATION_GRACE_SECONDS=5

DATABASE_URL=postgres://auth_user:auth_password@auth_db:5432/auth_db
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=http://localhost:8000/yandex/callback
YANDEX_USERINFO_URL=https://login.yandex.ru/info
YANDEX_BROKER_ISSUER=http://localhost:8000/yandex
YANDEX_BROKER_CLIENT_ID=bionicpro-yandex-broker
YANDEX_BROKER_CLIENT_SECRET=change-me-yandex-oidc-client-secret
YANDEX_BROKER_PRIVATE_KEY_FILE=/var/lib/bionicpro-auth/yandex-broker-private-key.pem
